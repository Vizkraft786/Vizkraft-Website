# registry.npmjs.org is unreachable on this network (times out on both IPv4 and
# IPv6 while the rest of the internet resolves fine). registry.yarnpkg.com is
# the official Yarn mirror of the same registry and serves identical packages.
# Project-scoped on purpose — this does not change global npm config.
registry=https://registry.yarnpkg.com/
fetch-retries=5
fetch-retry-maxtimeout=120000
